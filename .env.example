# crash-dash env — copy to .env.local (gitignored) and fill in.
#
# TWO env files, kept separate on purpose (both gitignored):
#   .env.local  — DEV ONLY. Local `supabase start` stack + dev tooling. This template.
#   .env.prod   — ALL PROD creds (prod Supabase, project ref + DB password, VERCEL_TOKEN,
#                 CRON_SECRET). Consumed by the local release chain (scripts/ship.sh →
#                 migrate-prod-local.sh / deploy-prod-local.sh) and prod-cron probes. Never
#                 put a prod value in .env.local. See the ".env.prod" block at the bottom.
#
# Local dev: copy SERVICE_ROLE_KEY from `npx supabase status -o env` (auth is enabled in
# supabase/config.toml so the CLI prints its stock local keys; they are valid only against
# the local stack). Both store modes use service_role (bypasses RLS); `getStore("ro")` is
# read-only because its handle holds no write method. The anon key is for auth only.

SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_KEY=

# Public anon key. NOT a store key — `getStore("ro")` reads on SUPABASE_SERVICE_KEY behind a
# read-only handle. Consumed by the browser pages' sign-in session.
#
# Local dev: copy ANON_KEY from `npx supabase status -o env`. It is a local-only
# credential and grants nothing anywhere else; NEVER put it in .env.prod.
#
# Prod: the real anon key from Supabase → Project Settings → API, set in the Vercel
# project env (`vercel env add SUPABASE_ANON_KEY`). Not needed in .env.prod — the
# running app reads it from Vercel.
SUPABASE_ANON_KEY=

# Notifier (ntfy). Topic the run pushes to. The topic name IS the auth — anyone
# who knows it can read every alert and POST spoofed pushes — so use a private,
# hard-to-guess value in prod (Vercel env). Unset falls back to a non-secret dev
# default (see src/config.ts); fine for local, NOT for prod. Consumed by src/ntfy.ts.
NTFY_TOPIC=

# Email fan-out of the BAND push (Brevo transactional API, src/email.ts). Both OPTIONAL:
# blank ⇒ email is skipped with a warning (ntfy still pushes). BREVO_API_KEY from the Brevo
# dashboard (free tier, 300 mails/day); EMAIL_FROM = the Brevo-VERIFIED sender address —
# an unverified address is rejected by Brevo. Prod: `vercel env add` (write-only).
BREVO_API_KEY=
EMAIL_FROM=

# Optional runtime knobs, all blank = unset (src/config.ts ENV_KEYS is the full list).
# FRED_API_KEY: free key (FRED keyed path).
FRED_API_KEY=
# LADDER_TZ: ladder render zone; blank = Europe/Tallinn.
LADDER_TZ=
# Set by the platform (Vercel / Node), never by hand.
VERCEL=
VERCEL_DEPLOYMENT_ID=
VERCEL_PROJECT_PRODUCTION_URL=
NODE_ENV=
# Probe / tooling only: prod read alias (required; no default), PageSpeed key, Supabase mgmt token + DB pooler.
PROD_ALIAS=
PSI_API_KEY=
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=
# One-command override of the checkout's `.prod-writes` switch (on|off); blank = the file decides (src/prod-writes.ts).
PROD_WRITES=

# ─────────────────────────────────────────────────────────────────────────────
# .env.prod — PROD creds template (separate file; do NOT put these in .env.local).
# Copy the block below into a `.env.prod` and fill in. Consumed by the local
# release chain and prod-cron probes; the running app reads these from Vercel env.
# ─────────────────────────────────────────────────────────────────────────────
# SUPABASE_URL=https://<project-ref>.supabase.co   # prod project URL
# SUPABASE_SERVICE_KEY=                             # prod service_role key
# VERCEL_TOKEN=                                    # OPTIONAL non-interactive deploy token; blank = `vercel login`

# Prod-only (fill in .env.prod, leave blank in .env.local):
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=
CRON_SECRET=
